<mxfile host="app.diagrams.net" type="device"><diagram id="setup" name="Setup"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1520" background="#FFFFFF" adaptiveColors="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="setup-title-1" value="&lt;span style=&quot;font-size:26px;font-weight:bold;color:#0F172A&quot;&gt;Kargo lab · the whole setup&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B&quot;&gt;Two Rust agents and an MCP server, each promoted through its own stages by Kargo and Argo CD on one kind cluster&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1100" height="70" as="geometry"/></mxCell><mxCell id="setup-lg-2" value="" style="rounded=1;arcSize=25;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="34" width="14" height="14" as="geometry"/></mxCell><mxCell id="setup-lgt-3" value="GitHub / your machine" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#475569;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1200" y="31" width="178" height="20" as="geometry"/></mxCell><mxCell id="setup-lg-4" value="" style="rounded=1;arcSize=25;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1380" y="34" width="14" height="14" as="geometry"/></mxCell><mxCell id="setup-lgt-5" value="Kargo" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#475569;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1400" y="31" width="178" height="20" as="geometry"/></mxCell><mxCell id="setup-lg-6" value="" style="rounded=1;arcSize=25;fillColor=#FFF7ED;strokeColor=#FDBA74;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1580" y="34" width="14" height="14" as="geometry"/></mxCell><mxCell id="setup-lgt-7" value="Argo CD" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#475569;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1600" y="31" width="178" height="20" as="geometry"/></mxCell><mxCell id="setup-lg-8" value="" style="rounded=1;arcSize=25;fillColor=#ECFDF5;strokeColor=#6EE7B7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="58" width="14" height="14" as="geometry"/></mxCell><mxCell id="setup-lgt-9" value="Workloads" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#475569;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1200" y="55" width="178" height="20" as="geometry"/></mxCell><mxCell id="setup-lg-10" value="" style="rounded=1;arcSize=25;fillColor=#F5F3FF;strokeColor=#C4B5FD;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1380" y="58" width="14" height="14" as="geometry"/></mxCell><mxCell id="setup-lgt-11" value="AI gateway" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#475569;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1400" y="55" width="178" height="20" as="geometry"/></mxCell><mxCell id="setup-lg-12" value="" style="rounded=1;arcSize=25;fillColor=#F0F7FF;strokeColor=#9CC9F0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1580" y="58" width="14" height="14" as="geometry"/></mxCell><mxCell id="setup-lgt-13" value="Azure" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#475569;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1600" y="55" width="178" height="20" as="geometry"/></mxCell><mxCell id="setup-grp-14" value="&lt;b&gt;GitHub&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#64748B&quot;&gt;gbaeke/kargo-demo (public)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=15;fontColor=#1E293B;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1840" height="200" as="geometry"/></mxCell><mxCell id="setup-card-15" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#1E293B&quot;&gt;1 · You push a tag&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;git tag research/v0.4.0&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;git push origin …&lt;/font&gt;&lt;br&gt;&lt;br&gt;Form: &lt;b&gt;&amp;lt;app&amp;gt;/v&amp;lt;semver&amp;gt;&lt;/b&gt;. A push to main builds nothing.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-14"><mxGeometry x="15" y="45" width="210" height="135" as="geometry"/></mxCell><mxCell id="setup-card-16" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#1E293B&quot;&gt;2 · Actions: release.yaml&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;Builds &lt;b&gt;only the tagged app&lt;/b&gt; with the one Dockerfile (&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;APP&lt;/font&gt;, &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;VERSION&lt;/font&gt; build args): a static musl binary in a distroless image.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-14"><mxGeometry x="245" y="45" width="250" height="135" as="geometry"/></mxCell><mxCell id="setup-card-17" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#1E293B&quot;&gt;3 · Images on GHCR&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;…/kargo-demo/helpdesk&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;…/kargo-demo/research&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;…/kargo-demo/mcp-server&lt;/font&gt;&lt;br&gt;Public, tag = version. The version is baked in.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-14"><mxGeometry x="515" y="45" width="240" height="135" as="geometry"/></mxCell><mxCell id="setup-card-18" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#1E293B&quot;&gt;Stage branches · written by Kargo&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;stage/&amp;lt;app&amp;gt;/&amp;lt;stage&amp;gt;&lt;/font&gt;, one per app and stage (7).&lt;br&gt;Finished manifests with the image tag filled in: ConfigMap, Service, Deployment. One commit per promotion. Never edited by hand.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-14"><mxGeometry x="775" y="45" width="330" height="135" as="geometry"/></mxCell><mxCell id="setup-card-19" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#1E293B&quot;&gt;Branch main · yours&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;agents/helpdesk&lt;/font&gt;, &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;agents/research&lt;/font&gt;, &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;mcp-server&lt;/font&gt;: Rust code + &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;deploy/base&lt;/font&gt; and &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;deploy/stages/&amp;lt;stage&amp;gt;&lt;/font&gt; (kustomize, image &lt;b&gt;without a tag&lt;/b&gt;)&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;kargo/&lt;/font&gt; pipelines · &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;argocd/&lt;/font&gt; ApplicationSet · &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;agentgateway/&lt;/font&gt; gateway, model, MCP routes · &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;cluster/&lt;/font&gt; scripts&lt;br&gt;Read only by a promotion: a change to a deploy folder takes effect at the next promotion.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-14"><mxGeometry x="1125" y="45" width="700" height="135" as="geometry"/></mxCell><mxCell id="setup-e-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#64748B;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="setup-card-15" target="setup-card-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="setup-e-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#64748B;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="setup-card-16" target="setup-card-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="setup-grp-22" value="&lt;b&gt;kind cluster · kargo&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=15;fontColor=#1E293B;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1600" height="940" as="geometry"/></mxCell><mxCell id="setup-grp-23" value="&lt;b&gt;Kargo&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#64748B&quot;&gt;v1.12.5 · decides what goes where&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=15;fontColor=#1E3A8A;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="setup-grp-22"><mxGeometry x="20" y="50" width="560" height="860" as="geometry"/></mxCell><mxCell id="setup-card-24" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#1E3A8A&quot;&gt;ClusterPromotionTask · promote-agent&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;The one recipe every Stage runs:&lt;br&gt;&lt;b&gt;1&lt;/b&gt; git-clone main + the stage branch&lt;br&gt;&lt;b&gt;2&lt;/b&gt; git-clear the stage branch&lt;br&gt;&lt;b&gt;3&lt;/b&gt; kustomize-set-image: the Freight&#x27;s tag&lt;br&gt;&lt;b&gt;4&lt;/b&gt; kustomize-build the stage overlay&lt;br&gt;&lt;b&gt;5&lt;/b&gt; git-commit · &lt;b&gt;6&lt;/b&gt; git-push (retries 3×)&lt;br&gt;&lt;b&gt;7&lt;/b&gt; argocd-update, wait for Healthy&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-23"><mxGeometry x="15" y="45" width="290" height="175" as="geometry"/></mxCell><mxCell id="setup-card-25" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#1E3A8A&quot;&gt;Control plane · ns kargo&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;&lt;b&gt;api&lt;/b&gt;: UI and CLI on &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;:31081&lt;/font&gt;&lt;br&gt;&lt;b&gt;controller&lt;/b&gt;: asks the registry for new tags every minute, creates Freight, runs promotions&lt;br&gt;+ webhooks, management controller&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-23"><mxGeometry x="320" y="45" width="225" height="175" as="geometry"/></mxCell><mxCell id="setup-card-26" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#1E3A8A&quot;&gt;Secret gitops-repo · ns kargo-shared-resources &lt;span style=&quot;background-color:#FEF3C7;color:#92400E;border-radius:9px;padding:1px 7px;font-size:9px;font-weight:bold;&quot;&gt;not in git&lt;/span&gt;&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;GitHub token for pushing stage branches. Every project finds it by its label and repo URL.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-23"><mxGeometry x="15" y="235" width="530" height="58" as="geometry"/></mxCell><mxCell id="setup-card-27" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#1E3A8A&quot;&gt;Project helpdesk · ns helpdesk&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="setup-grp-23"><mxGeometry x="15" y="308" width="530" height="110" as="geometry"/></mxCell><mxCell id="setup-node-28" value="&lt;b&gt;Warehouse&lt;/b&gt;&lt;br&gt;image → Freight" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fillColor=#2563EB;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="setup-card-27"><mxGeometry x="15" y="50" width="118" height="42" as="geometry"/></mxCell><mxCell id="setup-node-29" value="&lt;b&gt;dev&lt;/b&gt;&lt;br&gt;automatic" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;" vertex="1" parent="setup-card-27"><mxGeometry x="159" y="50" width="165" height="42" as="geometry"/></mxCell><mxCell id="setup-e-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#2563EB;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;endSize=5;strokeWidth=1.2;" edge="1" parent="setup-card-27" source="setup-node-28" target="setup-node-29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="setup-node-31" value="&lt;b&gt;prod&lt;/b&gt;&lt;br&gt;you promote" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;" vertex="1" parent="setup-card-27"><mxGeometry x="350" y="50" width="165" height="42" as="geometry"/></mxCell><mxCell id="setup-e-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#2563EB;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;endSize=5;strokeWidth=1.2;" edge="1" parent="setup-card-27" source="setup-node-29" target="setup-node-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="setup-card-33" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#1E3A8A&quot;&gt;Project research · ns research&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="setup-grp-23"><mxGeometry x="15" y="433" width="530" height="110" as="geometry"/></mxCell><mxCell id="setup-node-34" value="&lt;b&gt;Warehouse&lt;/b&gt;&lt;br&gt;image → Freight" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fillColor=#2563EB;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="setup-card-33"><mxGeometry x="15" y="50" width="118" height="42" as="geometry"/></mxCell><mxCell id="setup-node-35" value="&lt;b&gt;dev&lt;/b&gt;&lt;br&gt;automatic" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;" vertex="1" parent="setup-card-33"><mxGeometry x="159" y="50" width="101" height="42" as="geometry"/></mxCell><mxCell id="setup-e-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#2563EB;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;endSize=5;strokeWidth=1.2;" edge="1" parent="setup-card-33" source="setup-node-34" target="setup-node-35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="setup-node-37" value="&lt;b&gt;test&lt;/b&gt;&lt;br&gt;automatic" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;" vertex="1" parent="setup-card-33"><mxGeometry x="286" y="50" width="101" height="42" as="geometry"/></mxCell><mxCell id="setup-e-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#2563EB;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;endSize=5;strokeWidth=1.2;" edge="1" parent="setup-card-33" source="setup-node-35" target="setup-node-37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="setup-node-39" value="&lt;b&gt;prod&lt;/b&gt;&lt;br&gt;you promote" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;" vertex="1" parent="setup-card-33"><mxGeometry x="413" y="50" width="101" height="42" as="geometry"/></mxCell><mxCell id="setup-e-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#2563EB;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;endSize=5;strokeWidth=1.2;" edge="1" parent="setup-card-33" source="setup-node-37" target="setup-node-39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="setup-card-41" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#1E3A8A&quot;&gt;Project mcp-server · ns mcp-server&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="setup-grp-23"><mxGeometry x="15" y="558" width="530" height="110" as="geometry"/></mxCell><mxCell id="setup-node-42" value="&lt;b&gt;Warehouse&lt;/b&gt;&lt;br&gt;image → Freight" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fillColor=#2563EB;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="setup-card-41"><mxGeometry x="15" y="50" width="118" height="42" as="geometry"/></mxCell><mxCell id="setup-node-43" value="&lt;b&gt;dev&lt;/b&gt;&lt;br&gt;automatic" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;" vertex="1" parent="setup-card-41"><mxGeometry x="159" y="50" width="165" height="42" as="geometry"/></mxCell><mxCell id="setup-e-44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#2563EB;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;endSize=5;strokeWidth=1.2;" edge="1" parent="setup-card-41" source="setup-node-42" target="setup-node-43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="setup-node-45" value="&lt;b&gt;prod&lt;/b&gt;&lt;br&gt;you promote" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;" vertex="1" parent="setup-card-41"><mxGeometry x="350" y="50" width="165" height="42" as="geometry"/></mxCell><mxCell id="setup-e-46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#2563EB;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;endSize=5;strokeWidth=1.2;" edge="1" parent="setup-card-41" source="setup-node-43" target="setup-node-45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="setup-card-47" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#1E3A8A&quot;&gt;How Freight moves&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;&lt;b&gt;Freight&lt;/b&gt; = one image tag, with a two-word alias. A Stage only accepts Freight &lt;b&gt;verified&lt;/b&gt; in the Stage before it: promoted there and its Argo CD Application Healthy. Promoting never changes Freight, so rolling back is promoting an older one. Auto-promotion is set per Stage in the ProjectConfig.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-23"><mxGeometry x="15" y="683" width="530" height="92" as="geometry"/></mxCell><mxCell id="setup-card-48" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#1E3A8A&quot;&gt;cert-manager · ns cert-manager&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;Issues the TLS certificates Kargo&#x27;s internal webhooks need. Nothing else uses it.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-23"><mxGeometry x="15" y="790" width="530" height="52" as="geometry"/></mxCell><mxCell id="setup-grp-49" value="&lt;b&gt;Argo CD&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#64748B&quot;&gt;v3.6.1 · applies git&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFF7ED;strokeColor=#FDBA74;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=15;fontColor=#7C2D12;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="setup-grp-22"><mxGeometry x="660" y="50" width="300" height="860" as="geometry"/></mxCell><mxCell id="setup-card-50" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#7C2D12&quot;&gt;ns argocd&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;&lt;b&gt;server&lt;/b&gt;: UI on &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;:31080&lt;/font&gt;&lt;br&gt;&lt;b&gt;repo-server&lt;/b&gt;: reads the stage branches&lt;br&gt;&lt;b&gt;application-controller&lt;/b&gt;: applies them&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-49"><mxGeometry x="15" y="45" width="270" height="95" as="geometry"/></mxCell><mxCell id="setup-card-51" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#7C2D12&quot;&gt;ApplicationSet · agents&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;A list of {app, stage} pairs → 7 Applications. Each is annotated &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;authorized-stage&lt;/font&gt; for its one Kargo Stage. &lt;b&gt;No auto-sync&lt;/b&gt;: Kargo starts every sync.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-49"><mxGeometry x="15" y="155" width="270" height="105" as="geometry"/></mxCell><mxCell id="setup-grp-52" value="&lt;b&gt;Workloads&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#64748B&quot;&gt;ns &amp;lt;app&amp;gt;-&amp;lt;stage&amp;gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECFDF5;strokeColor=#6EE7B7;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=15;fontColor=#064E3B;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="setup-grp-22"><mxGeometry x="980" y="50" width="300" height="860" as="geometry"/></mxCell><mxCell id="setup-card-53" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#064E3B&quot;&gt;Agents · Rust, axum&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;One question in, one answer out: &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;/chat&lt;/font&gt;. &lt;b&gt;No keys&lt;/b&gt;. Model, tools and the other agent are reached through the gateway. helpdesk asks research over &lt;b&gt;A2A&lt;/b&gt;.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-52"><mxGeometry x="15" y="45" width="270" height="95" as="geometry"/></mxCell><mxCell id="setup-card-54" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#064E3B&quot;&gt;MCP server · Rust, rmcp&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;Tools &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;current_time&lt;/font&gt; and &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;magic_8_ball&lt;/font&gt; (since 0.2.0). A &lt;b&gt;NetworkPolicy&lt;/b&gt; lets only the gateway&#x27;s proxy pods connect; a direct call from an agent times out.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-52"><mxGeometry x="15" y="155" width="270" height="105" as="geometry"/></mxCell><mxCell id="setup-grp-55" value="&lt;b&gt;AI gateway&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#64748B&quot;&gt;agentgateway v1.7.0&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F3FF;strokeColor=#C4B5FD;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=15;fontColor=#4C1D95;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="setup-grp-22"><mxGeometry x="1300" y="50" width="280" height="860" as="geometry"/></mxCell><mxCell id="setup-card-56" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#4C1D95&quot;&gt;Controller &lt;span style=&quot;background-color:#FEF3C7;color:#92400E;border-radius:9px;padding:1px 7px;font-size:9px;font-weight:bold;&quot;&gt;optional&lt;/span&gt;&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;ns agentgateway-system. Installed by &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;cluster/agentgateway.sh&lt;/font&gt;, not by Kargo or Argo CD. Starts the proxy.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C4B5FD;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-55"><mxGeometry x="15" y="45" width="250" height="95" as="geometry"/></mxCell><mxCell id="setup-card-57" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#4C1D95&quot;&gt;AgentgatewayModel · gpt-6-luna&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;The only model served. Provider Azure, Foundry. The API key comes from the Secret &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;azure&lt;/font&gt; &lt;span style=&quot;background-color:#FEF3C7;color:#92400E;border-radius:9px;padding:1px 7px;font-size:9px;font-weight:bold;&quot;&gt;not in git&lt;/span&gt; and is added to each request.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C4B5FD;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-55"><mxGeometry x="15" y="155" width="250" height="105" as="geometry"/></mxCell><mxCell id="setup-card-58" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#4C1D95&quot;&gt;Proxy · ns ai-gateway&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;Service &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;ai-gateway:8080&lt;/font&gt;, inside the cluster only.&lt;br&gt;&lt;br&gt;The agents&#x27; &lt;b&gt;single way out&lt;/b&gt;:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;/v1/chat/completions&lt;/font&gt;&lt;br&gt;model requests → Azure&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;/mcp/dev&lt;/font&gt;, &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;/mcp/prod&lt;/font&gt;&lt;br&gt;tool calls → MCP server&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;/a2a/research/dev&lt;/font&gt;, &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;…/prod&lt;/font&gt;&lt;br&gt;A2A: helpdesk → research, port 3001&lt;br&gt;&lt;br&gt;dev and test agents use the dev paths, prod agents the prod paths.&lt;br&gt;&lt;br&gt;No caller keys: fine for a lab only.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C4B5FD;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-55"><mxGeometry x="15" y="275" width="250" height="348" as="geometry"/></mxCell><mxCell id="setup-card-59" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#4C1D95&quot;&gt;MCP routes&lt;/span&gt;&lt;div style=&quot;margin-top:4px;line-height:1.35&quot;&gt;HTTPRoute &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;mcp&lt;/font&gt; with two AgentgatewayBackends:&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;/mcp/dev&lt;/font&gt; → mcp-server-dev&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;/mcp/prod&lt;/font&gt; → mcp-server-prod&lt;br&gt;Stateless, streamable HTTP, port 8081.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C4B5FD;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=11;spacingRight=9;spacingTop=8;fontSize=11;fontColor=#475569;" vertex="1" parent="setup-grp-55"><mxGeometry x="15" y="635" width="250" height="132" as="geometry"/></mxCell><mxCell id="setup-node-60" value="&lt;b&gt;Application helpdesk-dev&lt;/b&gt;&lt;br&gt;reads stage/helpdesk/dev" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#FDBA74;fontColor=#7C2D12;" vertex="1"